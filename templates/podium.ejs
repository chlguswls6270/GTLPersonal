<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/podium.css">
    <title>Podium</title>
</head>
<body>
    <h1 id="title">Leaderboard</h1>
    <div class="podium">
        <div class="rank second" id="second">
            <div class="name" id="name-2">None</div>
            <h1>2nd</h1>
            <p class="score" id="score-2">None</p>
        </div>
        <div class="rank first" id="first">
            <div class="name" id="name-1">None</div>
            <h1>1st</h1>
            <p class="score" id="score-1">None</p>
        </div>
        <div class="rank third" id="third">
            <div class="name" id="name-3">None</div>
            <h1>3rd</h1>
            <p class="score" id="score-3">None</p>
        </div>
    </div>
    <div class="rest-players">
        <ul id="restPlayersList">
            <!-- List items will be added dynamically here -->
        </ul>
    </div>
    <div class="home-button">
        <button id="homeButton">Home</button>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let users = "<%- users %>";
            users = JSON.parse(atob(users));
            console.log("this is inside of podium.ejs. first ranker is: " + users[0]);

            if (users.length == 1) {
                document.getElementById('second').style.display = 'none';
                document.getElementById('third').style.display = 'none';
                fillPodium(users);
            } else if (users.length == 2) {
                document.getElementById('third').style.display = 'none';
                fillPodium(users);
            } else if (users.length == 3) {
                fillPodium(users);
            } else {
                // Handle case with more or less than 1-3 users
                fillPodium(users.slice(0, 3));
                fillRestPlayers(users.slice(3));
            }
        });

        document.getElementById('homeButton').addEventListener('click', function() {
            window.location.href = '/';
        });

        function fillPodium(users) {
            users.forEach((elem, index) => {
                let nameId = `name-${index + 1}`;
                let scoreId = `score-${index + 1}`;
                document.getElementById(nameId).textContent = `${elem[0]}P`;
                document.getElementById(scoreId).textContent = `score: ${elem[1]}`;
            });
        }

        function fillRestPlayers(users) {
            const restPlayersList = document.getElementById('restPlayersList');
            users.forEach((elem, index) => {
                const listItem = document.createElement('li');
                listItem.textContent = `${index + 4}. ${elem[0]}P - score: ${elem[1]}`;
                restPlayersList.appendChild(listItem);
            });
        }

        function fillRestPlayers(users) {
            const restPlayersList = document.getElementById('restPlayersList');
            users.forEach((elem, index) => {
                const listItem = document.createElement('li');
                listItem.innerHTML = `<span>${index + 4}. ${elem[0]}P</span><span>${elem[1]}</span>`;
                restPlayersList.appendChild(listItem);
            });
        }
    </script>
</body>
</html>
