<!DOCTYPE html>
<html len="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <title>game page</title>
    <style>
        * {
            font-family: "Gugi", sans-serif;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
            overflow: hidden;
            height: 100vh;
            color:white;
            background-image: linear-gradient(to bottom, #1f1f1f 10%, #1d1d1d 20%, #000000 50%);
        }
        h1 {
            font-size: 6rem;
        }
        #buttons {
            position: absolute;
            bottom: 50px;
            display: flex;
            flex: row;
        }
        button {
            padding: 10px;
            margin: 10px;
            cursor: pointer;
            background-color: #1B1B1B;
            border: 1px solid white;
            color: white;
            transition: background-color 0.3s;
            font-size: 1em;
            z-index: 2;
            border-radius: 5px;
        }

        button:hover {
            color: black;
            background-color: white;
        }

        #tsparticles {
            position: fixed; /* Use fixed to keep it in the background */
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1; /* Ensures the particles are behind other content */
        }
        #text {
            text-align: center;
        }
        #text p {
            margin: 0;
            padding-bottom: 5px; /* Adjust the space between the elements as needed */
        }
        #text h1 {
            margin: 0;
        }
    </style>
</head>
<body>
    <div id="text">
        <p>if you are logged in,</p>
        <p>score went down by: <%- scoreChange -%></p>
        <h1>you lose...</h1>
    </div>
    <div id="buttons">
        <button id="home">Home</button>
        <button id = "nextGame">Continue</button>
    </div>
    <script>
        document.getElementById('nextGame').addEventListener('click', function() {
            window.location.href = '/multGame';  // Change this URL to the desired page
        });
        document.getElementById('home').addEventListener('click', function() {
            window.location.href = '/';  
        });
    </script>
</body>
