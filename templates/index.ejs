<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"> <!-- character encoding -->
   
    <meta name="description" content="Basic HTML5 Document">
    <meta name="keywords" content="HTML5, Responsive">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <title>Guess Lyrics</title>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode/build/jwt-decode.min.js"></script>
</head>

<body>
    <div class="title-container">
        <h1>Guess<br>Lyrics</h1>
    </div>
    <div class="button-container">
        <div class="login-row" id="login-row">
            <div id="custom-signin"></div>
        </div>
        <div class="upper-row">
            <button id="start">
                Practice Solo<br>
                <p>Practice on your own</p>
                <p>혼자 연습하기</p>
            </button>
            <button id="multGame">
                Random Match<br>
                <p>Compete against strangers online</p>
                <p>랜덤 매칭</p>
            </button>
            <button id="multPrivateGame">
                Play with Friends<br>
                <p>Create a private room and invite friends</p>
                <p>방 만들어서 친구와 게임하기</p>
            </button>
        </div>
        <div class="lower-row">
            <button id="addGame">Add Game</button>
            <button id="ranking">Ranking</button>
            <button id="form">Feedback</button>
        </div>
    </div>

    <div class="profile-container" id="profile-container">
        <img src="profile.jpg" alt="Profile Photo" id="profile-photo">
    </div>
    

    <div class="card" id="user-card">
        <div class="card-content">
            <p id="user-name">unknown</p>
            <p id="user-score">unkown</p>
            <p id="user-rank">unkown</p>
            <button id="logout-button" onclick="logout()">Logout</button>
        </div>
    </div>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        
        //check if user alrady logged-in
        document.addEventListener('DOMContentLoaded', () => {
            console.log("==========chlguswls")
            let info = sessionStorage.getItem("userInfo")
            info = JSON.parse(info)
            console.log("=====info: " + info)
            if (info != null) {
                console.log("===========already logged-in to google.")
                profilePhoto = document.getElementById("profile-photo")
                document.getElementById("login-row").style.display = "none"
                document.getElementById("profile-container").style.display = "inline"
                profilePhoto.src = info.image;
                document.getElementById('user-name').textContent = info.name;
                document.getElementById('user-score').textContent = "score: " + info.score;
                document.getElementById('user-rank').textContent = "rank: " + info.rank;
            }
        });

        // code to handle google login
        function handleCredentialResponse(response) {
            console.log("credential I got from the response: " + response.credential);
            fetch('/api/auth/google', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ token: response.credential })
            })
            .then(response => response.json())
            .then(data => {
                try {
                    const decoded = decodeJWT(data.authToken);
                    // console.log('Header:', decoded.header);
                    console.log('Payload:', decoded.payload);
                    // console.log('Signature:', decoded.signature);
                    profilePhoto = document.getElementById("profile-photo")
                    profilePhoto.src = decoded.payload.image;
                    //document.getElementById("g_id_signin").style.display = "none"
                    document.getElementById("profile-container").style.display = "inline"
                    let user = {
                        image: decoded.payload.image,
                        name: decoded.payload.name,
                        score: decoded.payload.score,
                        //sub: decoded.payload.sub,
                        obj: decoded.payload._id.toString(),
                        rank: decoded.payload.rank,
                    }
                    console.log("uesr's rank in client side: " + user.rank);
                    sessionStorage.setItem("userInfo", JSON.stringify(user))
                    sessionStorage.setItem("authToken", data.authToken)
                    console.log("stored user in session storage")
                    document.getElementById('user-name').textContent = decoded.payload.name;
                    //document.getElementById('user-score').textContent = decoded.payload._id.toString();
                    document.getElementById('user-score').textContent = decoded.payload.score;
                    document.getElementById('user-rank').textContent = "rank: " + decoded.payload.rank;
                    document.getElementById('custom-signin').style.visibility = 'hidden'
                } catch (error) {
                    console.error('Error decoding JWT:', error);
                }
                // Store the token or user info as needed
            })
            .catch(error => {
                console.error('Error during authentication:', error);
            });
        }

        window.onload = function() {
            google.accounts.id.initialize({
                client_id: '<%- clientID -%>',
                callback: handleCredentialResponse
            });

            google.accounts.id.renderButton(
                document.getElementById('custom-signin'),
                { theme: 'filled_black', size: 'large', text: 'Log In with Google' } // customization of the button
            );
        };

        async function logout() {
            // Clear sessionStorage
            const info = sessionStorage.getItem('userInfo');
            const objId = info.obj
            const authToken = sessionStorage.getItem('authToken');

            sessionStorage.clear();
            console.log("Cleared session storage");

            // Update the UI
            document.getElementById("profile-photo").src = "";
            document.getElementById('user-score').textContent = "";
            document.getElementById("profile-container").style.display = "none";
            document.getElementById('user-card').style.display = "none"
            document.getElementById('custom-signin').style.visibility = 'visible'
            //document.getElementById("g_id_signin").style.display = "block";
        }

        // JavaScript to handle the button click event
        document.getElementById('start').addEventListener('click', function() {
            window.location.href = '/songList';  // Change this URL to the desired page
        });

        document.getElementById('addGame').addEventListener('click', function() {
            window.location.href = '/addGame';  // Change this URL to the desired page
        });

        document.getElementById('multGame').addEventListener('click', function() {
            console.log("=============clicked multGame")
            window.location.href = '/multGame';  // Change this URL to the desired page
        });

        document.getElementById('multPrivateGame').addEventListener('click', function() {
            console.log("=============clicked multGame")
            window.location.href = '/multPrivateGame';  // Change this URL to the desired page
        });

        document.getElementById('ranking').addEventListener('click', function() {
            window.location.href = '/ranking';  // Change this URL to the desired page
        });

        document.getElementById('form').addEventListener('click', function() {
            window.location.href = 'https://docs.google.com/forms/d/e/1FAIpQLSdPPEttuF8o3Sg9QiEe5aD6o1Kway06wynbjMkUByGerPlfEA/viewform?usp=sf_link';  // Change this URL to the desired page
        });

        function base64UrlDecode(str) {
            // Replace URL-safe characters with base64 characters
            let base64 = str.replace(/-/g, '+').replace(/_/g, '/');
            // Pad the base64 string if needed
            switch (base64.length % 4) {
                case 2:
                    base64 += '==';
                    break;
                case 3:
                    base64 += '=';
                    break;
            }
            // Decode base64 string
            return decodeURIComponent(escape(window.atob(base64)));
        }

        function decodeJWT(token) {
            const parts = token.split('.');
            if (parts.length !== 3) {
                throw new Error('Invalid JWT');
            }

            const header = JSON.parse(base64UrlDecode(parts[0]));
            const payload = JSON.parse(base64UrlDecode(parts[1]));
            const signature = parts[2]; // Note: Signature is not decoded as it is binary data

            return {
                header: header,
                payload: payload,
                signature: signature
            };
        }
        //user info ard displaying logic
        const profileContainer = document.getElementById('profile-container');
        const userCard = document.getElementById('user-card');
        const logoutButton = document.getElementById('logout-button');
        
        profileContainer.addEventListener('click', () => {
            if (userCard.style.display === 'none' || userCard.style.display === '') {
                userCard.style.display = 'block';
            } else {
                userCard.style.display = 'none';
            }
        });

        // Close the card if clicking outside of it
        document.addEventListener('click', (event) => {
            if (!profileContainer.contains(event.target) && !userCard.contains(event.target)) {
                userCard.style.display = 'none';
            }
        });
    </script>
</body>
</html>


