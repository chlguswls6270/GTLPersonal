<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Song List</title>
    <link rel="stylesheet" href="/css/songList.css">
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <!-- Include Masonry library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/masonry/4.2.2/masonry.pkgd.min.js"></script>
</head>
<body>
    <div class="songList-left">
        <h1>Song<br>List</h1>
    </div>
    <div class="cards-container">
        <div class="cards" id="songListCards">
            
        </div>
        <div class="load-more-container">
            <button id="loadMoreButton">Load More</button>
        </div>
    </div>
    <script>
        let offset = 0;

        // Simulate a click on the "Load More" button when the document loads
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('loadMoreButton').click();
        });

        document.getElementById('loadMoreButton').addEventListener('click', async () => {
            const loadMoreButton = document.getElementById('loadMoreButton');
            loadMoreButton.disabled = true;
            loadMoreButton.textContent = "Loading..."
            try {
                const response = await fetch(`/loadMoreSongs?offset=${offset}`);
                const newSongs = await response.json();

                if (newSongs.length === 0) {
                    alert("No more songs to load");
                    return;
                }

                const songListCards = document.getElementById('songListCards');

                newSongs.forEach(song => {
                    const songCard = document.createElement('div');
                    songCard.classList.add('songListcard');
                    songCard.setAttribute('onclick', `window.location.href='songList/game/${song.youtubeURL}/${song.startTime}/${song.quizStartTime}/${song.quizEndTime}/${song._id}'`);
                    
                    const songContent = document.createElement('div');
                    songContent.classList.add('songListcard-content');
                    songContent.innerHTML = `
                        ${song.title}
                        <br><br>
                        ${song.artist}
                        <br><br>
                        <img src="${song.thumbnailURL}" alt="thumbnail" class="thumbnail">
                    `;
                    
                    songCard.appendChild(songContent);
                    songListCards.appendChild(songCard);
                });

                offset += newSongs.length;
                loadMoreButton.textContent = 'Load More'; // Change the button text back
                loadMoreButton.disabled = false; // Re-enable the button
            } catch (error) {
                console.error('Error loading more songs:', error);
            }
        });
    </script>
</body>
</html>
