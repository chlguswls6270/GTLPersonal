<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/demo.css">
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <title>single game</title>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7157638275487093"
     crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <div id="ad-container">
            Ad
        </div>

        <div id="player-container">
            <div id="player"></div>
            <div id="overlay"></div>
        </div>

        <div class="playButton">
            <button id="playButton">
                <i class="fas fa-play"></i>
            </button>
        </div>
        <div class="pauseButton">
            <button id="pauseButton">
                <i class="fas fa-pause"></i>
            </button>
        </div>
        <div class="backToQuizButton">
            <button id="backToQuizButton">
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </button>
        </div>

        <div class="formContainer" id="formContainer">
            <form id="userForm" action="<%- port -%>/songList/game" method="post">
                <div class="input-submit">
                    <div class="inputField"><input type="text" id="inputField" name="userAttempt" placeholder="click back button to go back"></div>
                    <!-- <div class="submitButton"><input type="submit" id="submitButton" value="Submit"></div> -->
                    <div class="submitButton">
                        <button id="submitButton" type="submit">
                            <i class="fa-solid fa-arrow-up-long"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="home-button">
            <button id="homeButton">
                <i class="fa-solid fa-house"></i>
            </button>
        </div>
        
        <div class="countdown" id="countdown">Wait!</div>
    </div>

    <!-- Modal HTML -->
    <div id="customAlert" class="modal">
        <div class="modal-content">
            <p id="failMessage">Incorrect solution. Please try again or go back to home.</p>
            <p id="sim">similarity: loading...</p>
            <button id="tryAgainButton">Try Again</button>
            <button id="goHomeButton">Go Back to Home</button>
        </div>
    </div>

    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
        //const { exec } = require('child_process');

        let player;
        const startTime = <%= startTime %>; // Start time in seconds
        //const endTime = 100;   // End time in seconds
        const quizStartTime = <%= quizStartTime %>;
        const quizEndTime = <%= quizEndTime %>;
        let quizStarted = false;
        let quizSubmitted = false;

        function onYouTubeIframeAPIReady() {
            player = new YT.Player('player', {
                height: '390',
                width: '640',
                videoId: '<%= id %>', // variable
                playerVars: {
                    'cc_load_policy': 1,
                    'cc_lang_pref': '',
                    'controls': 0,
                    'rel': 0,
                    'showinfo': 0,
                    'modestbranding': 1,
                    'start': Math.floor(startTime), //variable
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange
                }
            });
            console.log("player ready with youtube id: " + "<%= id %>");
        }

        function onPlayerReady(event) {
            
            const playButton = document.getElementById('playButton');
            const pauseButton = document.getElementById('pauseButton');
            const backToQuizButton = document.getElementById('backToQuizButton');
            const tryAgainButton = document.getElementById('tryAgainButton')

            playButton.addEventListener('click', () => {
                player.playVideo();
            });

            pauseButton.addEventListener('click', () => {
                if(quizStarted) {
                    player.pauseVideo();
                }
            });

            backToQuizButton.addEventListener('click', () => {
                if(quizStarted) {
                    player.seekTo(quizStartTime);
                    player.playVideo();
                }
            });

            tryAgainButton.addEventListener('click', () => {
                quizSubmitted = false;
                player.seekTo(quizStartTime);
                player.playVideo(); // Hide the form                
            });

            player.playVideo();
        }

        let checkTime;

        function checkPlayerTime() {
            const currentTime = player.getCurrentTime();
            if (currentTime >= quizStartTime && currentTime < quizEndTime && !quizStarted) {
                // Start countdown when quizStartTime begins
                player.pauseVideo();
                cancelAnimationFrame(checkTime);
                startCountdown();
                quizStarted = true;
            } else if (currentTime >= quizEndTime && !quizSubmitted) {
                player.pauseVideo();
                cancelAnimationFrame(checkTime);
                document.getElementById('formContainer').style.display = 'grid'; // Show the form
            } else {
                checkTime = requestAnimationFrame(checkPlayerTime);
            }
        }

        function onPlayerStateChange(event) {
            player.unloadModule("captions");  //Works for html5 ignored by AS3
            player.unloadModule("cc");  //Works for AS3 ignored by html5
            if (event.data == YT.PlayerState.PLAYING) {
                checkTime = requestAnimationFrame(checkPlayerTime);
            } else {
                cancelAnimationFrame(checkTime); // Stop checking when the video is not playing
            }
        } 

        function startCountdown() {
            const countdownElement = document.getElementById('countdown');
            countdownElement.style.display = 'flex'; // Show the countdown element
            let countdown = 3;

            const countdownInterval = setInterval(() => {
                countdownElement.textContent = countdown;
                if (countdown === 0) {
                    clearInterval(countdownInterval);
                    countdownElement.style.display = 'none'; // Hide the countdown element
                    document.getElementById('formContainer').style.display = 'grid'; // Show the form
                    document.getElementById('backToQuizButton').style.display = 'block';
                    player.seekTo(quizStartTime);
                    player.playVideo(); // Resume the video
                } else {
                    countdown--;
                }
            }, 1000); // Countdown every second
        }

        const submitButton = document.getElementById('submitButton');
        submitButton.addEventListener('click', () => {
            // const inputField = document.getElementById('inputField');
            // alert(`Submitted text: ${inputField.value}`);
            // document.getElementById('formContainer').style.display = 'none'; // Hide the form
            // document.getElementById('backToQuizButton').style.display = 'none';

            quizSubmitted = true;
            player.playVideo(); // Resume the video after form submission
        });

        // Function to encode special characters to HTML entities
        function encodeForHtml(str) {
            return str.replace(/&/g, '&amp;')
                      .replace(/</g, '&lt;')
                      .replace(/>/g, '&gt;')
                      .replace(/"/g, '&#34;')
                      .replace(/'/g, '&#39;')
                      .replace(/\//g, '&#x2F;')
                      .replace(/`/g, '&#x60;')
                      .replace(/=/g, '&#x3D;');
        }

        const solutionData = "<%- solution %>".toLowerCase();
        // console.log("soleution in ejs: " + solutionData);
        // Add event listener to the form
        document.getElementById('userForm').addEventListener('submit', async function(event) {
            let userInput = document.getElementById('inputField').value;
            userInput = encodeForHtml(userInput).toLowerCase();
            console.log("=======" + userInput);
            // Check if user input matches the solution
            if (userInput !== solutionData) {
                event.preventDefault(); // Prevent form submission
                document.getElementById('customAlert').style.display = 'flex';
                let sim;
                try {
                    sim = await calculateSimilarity(userInput, solutionData);
                    console.log("sim: " + sim);
                } catch (error) {
                    console.log("error when calculating sim")
                }
                console.log("sim: " + sim);
                document.getElementById('sim').textContent = `similarity: ${sim}%`;
            }
        });
        function getRootUrl() {
            const url = window.location;
            const protocol = url.protocol; // 'http:' or 'https:'
            const host = url.host;         // 'example.com' or 'example.com:3000'
            return `${protocol}//${host}`;
        }
        let currUrl = getRootUrl()
        async function calculateSimilarity(sentence1, sentence2) {
            try {
                const response = await fetch(`${currUrl}/calculate-similarity`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ sentence1, sentence2 })
                });
                const data = await response.json();
                if (data.error) {
                    console.log("error calculating sim");
                    throw new Error(data.error);
                } else {
                    let sim = data.similarity.toFixed(2);
                    console.log("sim is: " + sim);
                    return sim;
                }
            } catch (error) {
                console.error("Error:", error);
                throw error;
            }
        }

        // Handle Try Again button click
        document.getElementById('tryAgainButton').addEventListener('click', function() {
            document.getElementById('customAlert').style.display = 'none'; // Hide modal
            document.getElementById('sim').textContent='similarity: loading...';
        });

        // Handle Go Back to Home button click
        document.getElementById('goHomeButton').addEventListener('click', function() {
            console.log("=======");
            window.location.href = '/'; // Redirect to home page
        });
        
        // Handle Go Back to Home button click
        document.getElementById('homeButton').addEventListener('click', function() {
            console.log("=======");
            window.location.href = '/'; // Redirect to home page
        });
        
        
    </script>
</body>
</html>
