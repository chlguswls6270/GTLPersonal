<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/css/confirm.css">
    <title>Add Game Confirmation</title>
	<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7157638275487093"
     crossorigin="anonymous"></script>
</head>

<body>
    <div class="container">
        <h1>New Quiz Sent!</h1>
        <p>Wait for developer to approve it</p>
        <div class="box">
            <div class="info"><strong>Artist</strong> <span><%- artist %></span></div>
            <div class="info"><strong>Title</strong> <span><%- title %></span></div>
            <div class="info"><strong>Lyrics</strong> <span><%- lyrics %></span></div>
            <div class="info"><strong>Music Start Time</strong> <span><%- startTime %></span></div>
            <div class="info"><strong>Quiz Start Time</strong> <span><%- quizStartTime %></span></div>
            <div class="info"><strong>Quiz End Time</strong> <span><%- quizEndTime %></span></div>
            <div class="info"><strong>YouTube Link</strong> <span><a href="<%- youtubeURL %>" target="_blank"><%- youtubeURL %></a></span></div>
        </div>
		<button id="homeButton">Home</button>
    </div>
	<script>
		document.getElementById('homeButton').addEventListener('click', function() {
            window.location.href = '/';
        });
	</script>
</body>

</html>
