<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ranking</title>
    <link rel="stylesheet" href="/css/ranking.css">
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7157638275487093"
     crossorigin="anonymous"></script>
</head>
<body>
    <div class="rank-left">
        <h1>Rank</h1>
    </div>
    <div class="container">
        <div class="user-info" id="user-info">
            <img id="profile-picture" src="default-profile.png" alt="Profile Picture">
            <div id="rank-block">
                <p id="user-ranking">Unknown</p>
                <p>Rank</p>
            </div>
            <div id="info-block">
                <p id="user-name">Unknown</p>
                <p id="user-score">Unknown</p>
            </div>
        </div>

        <div class="ranking-container">
            <div class="ranking-box" id="ranking-box"></div>
            <div class="pagination-buttons">
                <button id="prev-button" onclick="prevPage()">Previous</button>
                <button id="next-button" onclick="nextPage()">Next</button>
            </div>
        </div>
    </div>

    <script src="/js/ranking.js"></script>
</body>
</html>
