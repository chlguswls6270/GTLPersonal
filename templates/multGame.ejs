<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/multGame.css">
    <link href="https://fonts.googleapis.com/css2?family=Gugi&family=Sixtyfour&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <title>Multiplayer Game</title>
</head>
<body>
    <div class="container">
        <div id="player-container">
            <div id="player"></div>
            <div id="overlay"></div>
        </div>
        
        <div id="ad-container">
            Ad
        </div>

        <div id="chat-log"></div>

        <div class="playButton">
            <button id="playButton">
                <i class="fas fa-play"></i>
            </button>
        </div>
        <div class="pauseButton">
            <button id="pauseButton">
                <i class="fas fa-pause"></i>
            </button>
        </div>
        <div class="backToQuizButton">
            <button id="backToQuizButton">
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </button>
        </div>

        <div class="home-button">
            <button id="homeButton">
                <i class="fa-solid fa-house"></i>
            </button>
        </div>
        
        

        <div class="formContainer" id="formContainer">
            <form id="userForm">
                <div class="input-submit">
                    <div class="inputField"><input type="text" id="inputField" name="userAttempt" placeholder="Enter text here"></div>
                    <div class="submitButton">
                        <button id="submitButton" type="submit">
                            <i class="fa-solid fa-arrow-up-long"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <div class="countdown" id="countdown">wait!</div>
    </div>

    <div id="customAlert" class="modal">
        <div class="modal-content">
            <p id="failMessage">Incorrect solution. Please try again or go back to home.</p>
            <button id="tryAgainButton">Try Again</button>
            <button id="goHomeButton">Go Back to Home</button>
        </div>
    </div>

    <div id="gameDidNotStart" class="modal">
        <div class="modal-content">
            <p id="failMessage">Game did not start yet<br>Wait for other users</p>
        </div>
    </div>

    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
        let player;
        const startTime = "<%= startTime %>";
        const quizStartTime = "<%= quizStartTime %>";
        const quizEndTime = "<%= quizEndTime %>";
        // const portNumber = "<%= portNumber %>";
        const port = "<%= port %>"
        let quizStarted = false;
        let quizSubmitted = false;
        let playRequested = false;
        let latestAnswer = '';

        function onYouTubeIframeAPIReady() {
            console.log('YouTube IFrame API is ready');
            player = new YT.Player('player', {
                height: '390',
                width: '640',
                videoId: '<%= id %>',
                playerVars: {
                    'controls': 0,
                    'rel': 0,
                    'showinfo': 0,
                    'modestbranding': 1,
                    'start': Math.floor(startTime),
                    'cc_load_policy': 0,
                    'cc_lang_pref': '',
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange
                }
            });
        }

        function onPlayerReady(event) {
            const playButton = document.getElementById('playButton');
            const pauseButton = document.getElementById('pauseButton');
            const backToQuizButton = document.getElementById('backToQuizButton');
            const tryAgainButton = document.getElementById('tryAgainButton');

            playButton.addEventListener('click', () => {
                player.playVideo();
            });

            pauseButton.addEventListener('click', () => {
                if(quizStarted) {
                    player.pauseVideo();
                }
            });

            backToQuizButton.addEventListener('click', () => {
                if(quizStarted) {
                    player.seekTo(quizStartTime);
                    player.playVideo();
                }
            });

            tryAgainButton.addEventListener('click', () => {
                quizSubmitted = false;
                player.seekTo(quizStartTime);
                player.playVideo();
                //document.getElementById('pauseOverlay').style.display = 'none';
            });

            if (playRequested) {
                player.playVideo();
            }
            //player.playVideo();
        }

        let checkTime;

        function checkPlayerTime() {
            const currentTime = player.getCurrentTime();
            if (currentTime >= quizStartTime && currentTime < quizEndTime && !quizStarted) {
                // Start countdown when quizStartTime begins
                player.pauseVideo();
                cancelAnimationFrame(checkTime);
                startCountdown();
                quizStarted = true;
            } else if (currentTime >= quizEndTime && !quizSubmitted) {
                player.pauseVideo();
                cancelAnimationFrame(checkTime);
                document.getElementById('formContainer').style.display = 'flex'; // Show the form
            } else {
                checkTime = requestAnimationFrame(checkPlayerTime);
            }
        }

        function onPlayerStateChange(event) {
            player.unloadModule("captions");  //Works for html5 ignored by AS3
            player.unloadModule("cc");  //Works for AS3 ignored by html5
            if (event.data == YT.PlayerState.PLAYING) {
                checkTime = requestAnimationFrame(checkPlayerTime);
            } else {
                cancelAnimationFrame(checkTime); // Stop checking when the video is not playing
            }
        }

        function startCountdown() {
            const countdownElement = document.getElementById('countdown');
            countdownElement.style.display = 'flex';
            let countdown = 3;

            const countdownInterval = setInterval(() => {
                countdownElement.textContent = countdown;
                if (countdown === 0) {
                    clearInterval(countdownInterval);
                    countdownElement.style.display = 'none';
                    document.getElementById('formContainer').style.display = 'block';
                    document.getElementById('backToQuizButton').style.display = 'block';
                    player.seekTo(quizStartTime);
                    player.playVideo();
                } else {
                    countdown--;
                }
            }, 1000);
        }

        const submitButton = document.getElementById('submitButton');
        submitButton.addEventListener('click', () => {
            quizSubmitted = true;
            player.playVideo();
        });
        // Function to encode special characters to HTML entities
        function encodeForHtml(str) {
            return str.replace(/&/g, '&amp;')
                      .replace(/</g, '&lt;')
                      .replace(/>/g, '&gt;')
                      .replace(/"/g, '&#34;')
                      .replace(/'/g, '&#39;')
                      .replace(/\//g, '&#x2F;')
                      .replace(/`/g, '&#x60;')
                      .replace(/=/g, '&#x3D;');
        }

        const solutionData = "<%- solution %>".toLowerCase();
        console.log("=======solution: " + solutionData);

        document.getElementById('userForm').addEventListener('submit', function(event) {
            let userInput = document.getElementById('inputField').value;
            latestAnswer = userInput;
            userInput = encodeForHtml(userInput).toLowerCase();
            console.log("=======userInput: " + userInput);
            if (userInput !== solutionData) {
                console.log("==========got it wrong")
                console.log("=========correct answer: " + solutionData)
                console.log("=========user answer: " + (userInput))

                event.preventDefault();
                document.getElementById('customAlert').style.display = 'flex';
            }
        });

        document.getElementById('tryAgainButton').addEventListener('click', function() {
            document.getElementById('customAlert').style.display = 'none';
        });

        document.getElementById('homeButton').addEventListener('click', function() {
            window.location.href = '/';
        });


    </script>
    <script src="/js/multGame.js"></script>
</body>
</html>
